generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Slot {
  id        Int      @id @default(autoincrement())
  slotIndex Int      @unique
  isActive  Boolean  @default(false)
  name      String
  prompt1   String   @default("")
  prompt2   String   @default("")
  prompt3   String   @default("")
  prompt4   String   @default("")
  prompt5   String   @default("")
  context   String
  history   String?
  models    Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
