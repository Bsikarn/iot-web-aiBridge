generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
}

model Slot {
  id        Int      @id @default(autoincrement())
  slotIndex Int      @unique
  isActive  Boolean  @default(false)
  name      String
  prompt    String
  context   String
  history   String?
  models    Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
